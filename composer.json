{
  "name": "staempfli/symlinker-pro",
  "description": "Tool to create relative symlinks",
  "type": "staempfli-tool",
  "license": [
    "GPL-3.0"
  ],
  "authors": [
    {
      "name": "Juan Alonso",
      "email": "juan.alonso@staempfli.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "laravel-zero/phar-updater": "^1.4",
    "symfony/console": "^7.4"
  },
  "require-dev": {
    "humbug/box": "^4.7"
  },
  "autoload": {
    "psr-4": { "Staempfli\\Symlinker\\": "src/Staempfli/Symlinker/" }
  },
  "config": {
    "bin-dir": "bin",
    "platform": {
      "php": "8.3.0"
    },
    "sort-packages": true
  },
  "bin": ["bin/symlinker-pro"],
  "scripts": {
    "setPermissionsBin": "chmod -R +x bin",
    "post-install-cmd": [
      "@setPermissionsBin"
    ],
    "post-update-cmd": [
      "@setPermissionsBin"
    ]
  }
}
